# The `overrides` field in package.json pins react/react-dom to 18.3.1 across
# the entire dependency tree, which resolves the known React 19 peer-dependency
# conflicts (recharts, @stripe/react-stripe-js, and vaul all pin peer ranges
# that stop at ^18.0.0). legacy-peer-deps is kept as a defensive fallback so a
# single unusually strict peer range on some transitive package can't hard-fail
# the whole Vercel install — npm will warn on any remaining mismatch instead of
# erroring out.
legacy-peer-deps=true
