# -----------------------------------------------------------------------------
# SUPABASE
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# APP
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=FixLocal

# -----------------------------------------------------------------------------
# STRIPE
# -----------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
STRIPE_CONNECT_CLIENT_ID=ca_xxxxxxxxxxxx
NEXT_PUBLIC_APP_FEE_PERCENT=15

# Provider subscription tier price IDs (created in the Stripe Dashboard)
STRIPE_PRICE_STARTER=price_xxxxxxxxxxxx
STRIPE_PRICE_GROWTH=price_xxxxxxxxxxxx
STRIPE_PRICE_PRO=price_xxxxxxxxxxxx

# -----------------------------------------------------------------------------
# GOOGLE OAUTH (configured in Supabase Auth providers, keys used for Maps too)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your-google-maps-key

# -----------------------------------------------------------------------------
# APPLE OAUTH (configured in Supabase Auth providers)
# -----------------------------------------------------------------------------
# Apple Sign In is configured entirely in the Supabase Dashboard
# (Authentication > Providers > Apple). No app-level keys required here.

# -----------------------------------------------------------------------------
# EMAIL (Resend - transactional email: verification, receipts, notifications)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM="FixLocal <notifications@fixlocal.com>"

# -----------------------------------------------------------------------------
# N8N AUTOMATION ENGINE
# -----------------------------------------------------------------------------
# Outbound: FixLocal -> n8n. Point this at your n8n instance's webhook URL
# for the "FixLocal Events" workflow (see docs/N8N_INTEGRATION.md).
N8N_WEBHOOK_URL=https://your-n8n-instance.app.n8n.cloud/webhook/fixlocal-events
N8N_WEBHOOK_SECRET=generate-a-long-random-secret

# Inbound: n8n -> FixLocal (/api/webhooks/n8n). A separate secret from the
# outbound one, since the two directions have different trust boundaries.
N8N_INBOUND_SECRET=generate-a-different-long-random-secret

# Protects /api/cron/automation-retry. Vercel automatically sends this as a
# Bearer token when a project has scheduled Cron Jobs configured (vercel.json).
CRON_SECRET=generate-a-long-random-secret

# -----------------------------------------------------------------------------
# WEB PUSH (VAPID keys — generate with `npx web-push generate-vapid-keys`)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_VAPID_PUBLIC_KEY=your-vapid-public-key
VAPID_PRIVATE_KEY=your-vapid-private-key
VAPID_SUBJECT=mailto:support@fixlocal.com

# -----------------------------------------------------------------------------
# RATE LIMITING / SECURITY
# -----------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-upstash-endpoint.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-token
